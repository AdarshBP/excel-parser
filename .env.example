# PostgreSQL credentials. Copy to .env and fill in.
# Keep .env out of version control — it holds passwords.

PGHOST=localhost
PGPORT=5432
PGUSER=cos_user
PGPASSWORD=cos_password
PGSSLMODE=prefer

# Fallbacks — used only when the workbook's target_config leaves them blank.
PGDATABASE=excel_parser
PGSCHEMA=staging

# Alternative to the individual PG* settings above:
# DATABASE_URL=postgresql://user:password@host:5432/excel_parser

# -------------------------------------------------------- Application state
# The app's own tables (users, sessions, projects, runs, batches) live in
# PostgreSQL under this schema. Separate from loaded data.
APP_SCHEMA=excelparser_config

# ------------------------------------------------------------- Workbook directory
# Optional. The directory the file browser shows. Files are read directly
# from here — no copy, no upload. Leave blank to use only the project picker.
WORKBOOK_DIR=

# ---------------------------------------------------------------- Google Drive
# Optional. Without these the Drive source option shows as "not configured";
# file paths and direct links work without them.
#
# Google Cloud console -> APIs & Services:
#   1. enable the Google Drive API
#   2. create OAuth client credentials of type "Web application"
#   3. add GOOGLE_REDIRECT_URI as an authorised redirect URI (exact match)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback/google
APP_FRONTEND_URL=http://localhost:4200

# ---------------------------------------------------------------- Application
# APP_ENV=production           # secure cookies (set for real deployments)
# APP_ALLOWED_ORIGINS=https://your-domain.com    # CORS (default: http://localhost:4200)

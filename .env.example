# Excel Parser — environment configuration
# Copy to .env and fill in your values. Never commit .env itself.

# ──────────────────────────────────────────── PostgreSQL (required)
PGHOST=localhost
PGPORT=5432
PGUSER=your_user
PGPASSWORD=your_password
PGDATABASE=excel_parser
# optional: prefer | require | verify-full
PGSSLMODE=prefer

# alternative to the settings above:
# DATABASE_URL=postgresql://user:password@host:5432/excel_parser

# ──────────────────────────────────────────── Application
APP_SCHEMA=excelparser_config
# APP_ALLOWED_ORIGINS=http://localhost:4200
# APP_PORT=4200

# ──────────────────────────────────────────── Google Drive (optional)
# Without these, the "Google Drive" source option shows as not configured;
# local file paths and direct Google Sheets links still work.
#
# Google Cloud console → APIs & Services:
#   1. Enable the Google Drive API and Google Picker API
#   2. Create OAuth client credentials (type: Web application)
#   3. Add GOOGLE_REDIRECT_URI as an authorised redirect URI
#   4. Create an API key (restrict to Picker API)
#
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
# GOOGLE_API_KEY=AIzaSy-your-api-key
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback/google
# APP_FRONTEND_URL=http://localhost:4200

# ──────────────────────────────────────────── Docker deployment
# DOCKER_REGISTRY=adarshbp
# TAG=latest
# WORKBOOK_DIR=./workbooks

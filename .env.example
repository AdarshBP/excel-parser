# Excel Parser — environment configuration
# Copy to .env and fill in your values. Never commit .env itself.

# ──────────────────────────────────────────── PostgreSQL (required)
PGHOST=localhost
PGPORT=5432
PGUSER=your_user
PGPASSWORD=your_password
PGDATABASE=excel_parser
# optional: prefer | require | verify-full
PGSSLMODE=prefer

# alternative to the settings above:
# DATABASE_URL=postgresql://user:password@host:5432/excel_parser

# ──────────────────────────────────────────── Application
APP_SCHEMA=excelparser_config
# APP_ALLOWED_ORIGINS=https://app.yourdomain.com
# APP_PORT=4200

# ──────────────────────────────────────────── Google Drive (optional)
# Without these, the "Google Drive" source option shows as not configured;
# local file paths and direct Google Sheets links still work.
#
# Google Cloud console → APIs & Services:
#   1. Enable the Google Drive API and Google Picker API
#   2. Create OAuth client credentials (type: Web application)
#   3. Add GOOGLE_REDIRECT_URI as an authorised redirect URI (exact match)
#   4. Create an API key (restrict to Picker API)
#
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
# GOOGLE_API_KEY=AIzaSy-your-api-key
#
# The redirect URI and frontend URL must use the same origin the user
# accesses in the browser:
#
#   Local dev (./app/run.sh):    http://localhost:8000/api/auth/callback/google
#   Local Docker:                http://localhost:4200/api/auth/callback/google
#   Production Docker:           https://app.yourdomain.com/api/auth/callback/google
#
# Also add the URI in Google Cloud Console → Authorized redirect URIs (exact match).
# You can add multiple URIs there so both local and production work.
#
# GOOGLE_REDIRECT_URI=https://app.yourdomain.com/api/auth/callback/google
# APP_FRONTEND_URL=https://app.yourdomain.com

# ──────────────────────────────────────────── Docker deployment
# DOCKER_REGISTRY=adarshbp
# TAG=latest
